# Production Environment Variables for Docker Compose on AWS EC2
DJANGO_SECRET_KEY=generate_a_strong_random_secret_key_here
DJANGO_ALLOWED_HOSTS=api.voicechanger.internal,localhost,127.0.0.1
DEBUG=False

# PostgreSQL Configuration (Docker Internal Network)
POSTGRES_DB=whatsapp_voice
POSTGRES_USER=wv_app_user
POSTGRES_PASSWORD=use_a_very_secure_random_db_password_here

# CORS & CSRF
CORS_ALLOWED_ORIGINS=https://app.voicechanger.internal
CSRF_TRUSTED_ORIGINS=https://api.voicechanger.internal
